  "peerDependencies": {
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.0",
    "esphome-client": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "homebridge": "^2.0.2",
    "nodemon": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
