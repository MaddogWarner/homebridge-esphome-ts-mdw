{
  "displayName": "ESPHome MDW",
  "name": "homebridge-esphome-ts-mdw",
  "version": "1.1.1",
  "description": "Homebridge 2.0 plugin for ESPHome devices. Bridges ESP32 touch panels and other ESPHome entities to Apple HomeKit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaddogWarner/homebridge-esphome-ts-mdw.git"
  },
  "bugs": {
    "url": "https://github.com/MaddogWarner/homebridge-esphome-ts-mdw/issues"
  },
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/",
    "build": "rm -rf ./dist && tsc",
    "watch": "npm run build && nodemon",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "esphome",
    "esp32",
    "homekit",
    "touch",
    "stateless-programmable-switch"
